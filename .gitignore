# --- python envs / caches ---
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# --- C/C++ build output ---
build/
*.o
*.a
*.so
*.so.*

# --- model weights / engines ---
*.onnx
*.engine
*.pth
*.pt
*.safetensors
*.trt

# --- runtime state / scratch ---
*.log
# project-local runtime config (auto-generated: profiles.json, state.json)
/config/

# --- VITURE SDK (headers, libs, docs, demo): copyright VITURE Inc., not
# redistributable. Unzip it into viture-sdk/; it never goes into git.
/viture-sdk/

# --- local tutorial (docs/tutorial/): kept out of git on purpose ---
/docs/tutorial/

# --- sample 3D models (braindance view): others' work under their own licenses.
# Only the one whose license allows sharing (CC BY-NC 4.0, credited in the
# README) is in git; anything else you put here stays out. ---
/samples/*
!/samples/floral_woman.glb
!/samples/floral_woman-license.txt
